{
    "daemons": [
        {
            "heartbeat_field": "polled_at",
            "heartbeat_file": "~/hooks/state/fleet-queue/last-seen.json",
            "id": "fleet-queue",
            "log_file": "~/hooks/logs/fleet-queue-watcher.log",
            "pgrep": "^(.*[Pp]ython3?) .*/fleet-queue-poller/daemon\\.py --config .*$",
            "stale_secs": 180,
            "start": "nohup python3 ~/workspace/fleet-queue-poller/daemon.py --config ~/workspace/fleet-queue-poller/poller.config.json >> ~/hooks/logs/fleet-queue-watcher.log 2>&1 < /dev/null &",
            "stop_file": "~/hooks/state/fleet-queue-stop",
            "verify": "polled_at advancing in ~/hooks/state/fleet-queue/last-seen.json"
        },
        {
            "heartbeat_field": "polled_at",
            "heartbeat_file": "~/hooks/state/discord-mentions/last-seen.json",
            "id": "discord-mentions",
            "log_file": "~/hooks/logs/discord-mentions-watcher.log",
            "pgrep": "^(.*/)?bun .*/discord-mentions/daemon\\.ts --config .*$",
            "stale_secs": 50,
            "start": "nohup bun ~/workspace/discord-mentions/daemon.ts --config ~/workspace/discord-mentions/poller.config.json >> ~/hooks/logs/discord-mentions-watcher.log 2>&1 < /dev/null &",
            "stop_file": "~/hooks/state/discord-mentions-stop",
            "verify": "polled_at advancing in ~/hooks/state/discord-mentions/last-seen.json"
        }
    ]
}
